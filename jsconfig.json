{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "paths": {
      "@auth/*": ["./src/pages/auth/*"],
      "@pages/*": ["./src/pages/*"],
      "@components/*": ["./src/components/*"],
      "@api/*": ["./src/api/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@context/*": ["./src/context/*"]
    }
  },
  "include": ["src"]
}